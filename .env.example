# Copy to backend/.env and frontend/.env.local for local development.
# Real values live only in Railway (backend) and Vercel (frontend) dashboards.

# ---- backend (Railway) ----
GROQ_API_KEY=
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
MODEL_UNDERSTANDING=openai/gpt-oss-20b
MODEL_ANSWER=openai/gpt-oss-120b
REASONING_EFFORT_UNDERSTANDING=low
REASONING_EFFORT_ANSWER=medium
# Groq rate limits per model (free tier). Calls are paced/refused in code to stay inside them.
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000
LLM_MAX_WAIT_S=8
# Passage retrieval (fastembed). The Docker image sets EMBEDDING_CACHE_DIR=/app/models and
# downloads the model at build time; locally it is downloaded on first start.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=/path/to/model/cache
ALLOWED_ORIGINS=http://localhost:3000
# X-Admin-Token for GET /api/admin/failures; the endpoint is disabled (404) while empty.
ADMIN_TOKEN=
# Per-IP limit on POST /api/chat, and how many proxies append to X-Forwarded-For (Railway: 1).
RATE_LIMIT_CHAT=20/minute
TRUSTED_PROXY_HOPS=1
# Evals only: the database to read knowledge from (defaults to DATABASE_URL).
# EVAL_DATABASE_URL=postgresql://...

# ---- frontend (Vercel) ----
# Public: bundled into the browser. Never put GROQ_API_KEY or any secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
