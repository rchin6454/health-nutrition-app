# Copy to backend/.env and frontend/.env.local for local development.
# Real values live only in Railway (backend) and Vercel (frontend) dashboards.

# ---- backend (Railway) ----
GROQ_API_KEY=
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
MODEL_UNDERSTANDING=openai/gpt-oss-20b
MODEL_ANSWER=openai/gpt-oss-120b
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_TOKEN=

# ---- frontend (Vercel) ----
# Public: bundled into the browser. Never put GROQ_API_KEY or any secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
